{
  "name": "@degenly/agent",
  "version": "0.2.1",
  "mcpName": "io.github.degenly/degenly-agent",
  "description": "Degenly for AI agents: MCP server + CLI to look up and trade Solana tokens on Degenly. Demo mode needs no wallet; live mode uses a separate local agent wallet.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/degenly/degenly-agent.git"
  },
  "homepage": "https://degenly.app/bot",
  "bugs": {
    "url": "https://github.com/degenly/degenly-agent/issues"
  },
  "keywords": [
    "degenly",
    "mcp",
    "solana",
    "ai-agent",
    "memecoin",
    "cli",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "gemini-cli",
    "trading"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "degenly": "dist/cli.js",
    "agent": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
